# Neo4j connection (local or Aura/Kocla)
NEO4J_URI=bolt://localhost:7687
# Use NEO4J_USERNAME for Aura/Kocla (fallback: NEO4J_USER)
NEO4J_USER=neo4j
# NEO4J_USERNAME=your_aura_username
NEO4J_PASSWORD=your_password_here
# Optional: database name (e.g. Neo4j Aura)
# NEO4J_DATABASE=neo4j
# Aura instance (optional)
# AURA_INSTANCEID=your_instance_id
# AURA_INSTANCENAME=Instance01

# -----------------------------------------------------------------------------
# LLM & Embeddings: OpenAI or Ollama
# -----------------------------------------------------------------------------
# Provider: "openai" or "ollama"
# LLM_PROVIDER=openai
LLM_PROVIDER=ollama

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama (when LLM_PROVIDER=ollama) – run `ollama serve` and pull models locally
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2
# Optional: Ollama server URL (default http://localhost:11434). Use for healthcare RAG.
OLLAMA_BASE_URL=http://localhost:11434
# Optional: use different provider for embeddings only
# EMBEDDING_PROVIDER=ollama

# Vector index dimension (must match embedding model)
# OpenAI text-embedding-3-small = 1536; nomic-embed-text = 768
VECTOR_DIMENSION=768
